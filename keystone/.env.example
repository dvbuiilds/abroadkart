# Keystone (CRM backend). Copy to keystone/.env and fill in real values.
DATABASE_URL=postgres://user:password@localhost:5432/abroadkart
SESSION_SECRET=change-me
PORT=3001

# Blog: shared with the Next.js app. Must match the value set there.
# Only the Next.js server sends this in the x-internal-key header to create BlogLeads.
LEADS_INTERNAL_KEY=generate-with-openssl-rand-hex-32
# Shared secret for POST /api/revalidate on the Next.js app (Keystone afterOperation hook).
REVALIDATE_SECRET=generate-with-openssl-rand-hex-32
# Next.js internal URL for cache revalidation. Defaults to PUBLIC_APP_URL if not set.
NEXT_INTERNAL_URL=http://nextjs:3000

# Public R2 bucket for blog images (import script only). Use a token scoped to this bucket.
R2_PUBLIC_BUCKET_NAME=abroadkart-public
R2_PUBLIC_ACCESS_KEY_ID=your-public-bucket-access-key-id
R2_PUBLIC_SECRET_ACCESS_KEY=your-public-bucket-secret-access-key
# Public origin that serves the blog images. Must match the Next.js app.
BLOG_CDN_URL=https://cdn.abroadkart.com
